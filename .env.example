# Copy to .env and fill in real values (see README).
# Placeholders are safe for local dev — the app falls back to .data/local.db.

TURSO_URL=libsql://YOUR-DATABASE-NAME.turso.io
TURSO_TOKEN=YOUR_TURSO_AUTH_TOKEN

# 32-byte AES-256 key as 64 hex chars (encrypts guest PII at rest)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS

# Secret for signing sessions + hashing emails for guest lookup
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_64_HEX_CHARS

# EmailJS (optional — confirmation + contact emails)
VITE_EMAILJS_SERVICE_ID=YOUR_EMAILJS_SERVICE_ID
VITE_EMAILJS_PUBLIC_KEY=YOUR_EMAILJS_PUBLIC_KEY
VITE_EMAILJS_TEMPLATE_BOOKING=YOUR_EMAILJS_BOOKING_TEMPLATE_ID
VITE_EMAILJS_TEMPLATE_CONTACT=YOUR_EMAILJS_CONTACT_TEMPLATE_ID
